{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "life-sync-bot",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-08",
  "containers": [
    {
      "class_name": "BotRunner",
      "scheduling_policy": "durable_object",
      "images": {
        "base": {
          "dockerfile": "./Dockerfile"
        }
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOT_RUNNER",
        "class_name": "BotRunner"
      }
    ]
  },
  "exports": {
    "BotRunner": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
